    {
      "parameters": {
        "jsCode": "const b=$input.first().json.body ?? $input.first().json; const req=['proyecto','estacion','fecha_campo','geologo_nombre','geologo_email','tipo_estudio','descripcion']; const miss=req.filter(k=>!b[k]); if(miss.length) throw new Error('Campos obligatorios: '+miss.join(', ')); const id='GEO-'+new Date().toISOString().slice(0,10).replaceAll('-','')+'-'+String(b.estacion).toUpperCase().replace(/[^A-Z0-9]/g,'').slice(-10); return [{json:{...b,registro_id:id,latitud:b.latitud?Number(b.latitud):null,longitud:b.longitud?Number(b.longitud):null,elevacion_m:b.elevacion_m?Number(b.elevacion_m):null,evidencia_cantidad:Object.keys($input.first().binary||{}).length,estado:b.estado||'registrado'}}];"
      },
      "id": "b2bf6e4b-c7a9-47cc-b311-37c727b3ea70",
      "name": "Validar y normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        1120
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$input.first().json; const t=(x.tipo_estudio||'otro').toLowerCase(); const all=[x.descripcion,x.riesgo_observado,x.resultado_preliminar,x.material].filter(Boolean).join(' ').toLowerCase(); const classes={suelo:all.includes('contamin')?'contaminación de suelo':all.includes('geotec')?'geotecnia':'caracterización edáfica',roca:all.includes('sulf')||all.includes('mineral')?'mineralización':all.includes('falla')||all.includes('fractura')?'geología estructural':'litología',agua:all.includes('contamin')?'calidad de agua - posible contaminación':all.includes('ph')||all.includes('conductiv')?'hidroquímica':'hidrogeología',otro:'revisión técnica'}; let p=x.prioridad_declarada||'media'; if(/riesgo ambiental|riesgo para personas|derrame|contaminación severa/.test(all))p='critica'; else if(p==='alta'||/contamin|inestabilidad|sulfuro|mineralización|filtración/.test(all))p='alta'; return [{json:{...x,clasificacion:classes[t]||classes.otro,prioridad:p}}];"
      },
      "id": "f015683e-5cf7-4f44-8873-3d84fc3fff16",
      "name": "Clasificar y calcular prioridad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        1120
      ]
    },
