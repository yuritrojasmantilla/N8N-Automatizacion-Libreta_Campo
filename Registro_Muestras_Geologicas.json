        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Codigo": "={{ $json.sample_code }}",
            "Fecha": "={{ $json.date }}",
            "Geologo": "={{ $json.geologist }}",
            "Municipio": "={{ $json.municipality }}",
            "Tipo": "={{ $json.sample_type }}",
            "Litologia": "={{ $json.lithology }}",
            "Laboratorio": "={{ $json.laboratory }}",
            "Prioridad": "={{ $json.priority }}",
            "Estado": "={{ $json.status }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "node-sheets",
      "name": "Actualizar Inventario (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZA_CON_TU_CREDENCIAL_SHEETS",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
