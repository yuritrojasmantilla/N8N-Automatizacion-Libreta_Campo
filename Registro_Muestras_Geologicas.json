          },
          "conditions": [
            {
              "id": "cond-prioridad-alta",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "Alta",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-prioridad",
      "name": "¿Prioridad alta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 0]
    },
    {
      "parameters": {
        "sendTo": "laboratorio@empresa.com, coordinador@empresa.com, director@empresa.com",
        "subject": "=Nueva muestra prioritaria registrada: {{ $json.sample_code }}",
        "message": "=Se registró una nueva muestra.\n\nCódigo: {{ $json.sample_code }}\nTipo: {{ $json.sample_type }}\nLitología: {{ $json.lithology }}\nMunicipio: {{ $json.municipality }}\nPrioridad: {{ $json.priority }}\nLaboratorio asignado: {{ $json.laboratory }}\nGeólogo: {{ $json.geologist }}\n\nEl registro ya fue almacenado en PostgreSQL y agregado al inventario de Google Sheets.",
        "options": {}
      },
      "id": "node-gmail",
      "name": "Notificar Prioridad Alta",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [900, -120],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZA_CON_TU_CREDENCIAL_GMAIL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"mensaje\": \"Muestra registrada y notificada por prioridad alta\", \"sample_code\": $json.sample_code } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type" }
            ]
          }
        }
      },
      "id": "node-respond-alta",
      "name": "Responder (prioridad alta)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, -120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"mensaje\": \"Muestra registrada correctamente\", \"sample_code\": $json.sample_code } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type" }
            ]
          }
        }
      },
      "id": "node-respond-normal",
